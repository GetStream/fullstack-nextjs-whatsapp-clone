# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Update these with your Stream app's key and secret from https://dashboard.getstream.io/
# The secret is only read server-side (app/api/create-user/route.ts); never expose it to the browser.
NEXT_PUBLIC_REACT_APP_STREAM_KEY=your-stream-key
REACT_APP_STREAM_SECRET=your-stream-secret
